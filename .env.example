APP_ENV=production
PUBLIC_BASE_URL=https://makina-ops.example.go.ke
DATABASE_URL=postgresql+psycopg://makina:change-me@db:5432/makina
SECURE_COOKIES=true
SESSION_HOURS=12
BOOTSTRAP_ADMIN_EMAIL=officer@example.go.ke
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
OWNER_SETUP_TOKEN=replace-with-a-separate-random-one-time-token
DOCUMENT_ROOT=/app/data/documents
MAX_UPLOAD_BYTES=5242880
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=makina-ward@example.go.ke
AI_ENABLED=false
