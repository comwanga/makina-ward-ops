# Application
APP_ENV=development
PORT=3000
API_PORT=4000
PUBLIC_BASE_URL=http://127.0.0.1:3000

# API
API_INTERNAL_URL=http://127.0.0.1:4000
SESSION_HOURS=12
SECURE_COOKIES=false

# Database
DATABASE_URL=postgresql://ward_ops:ward_ops@localhost:5432/ward_ops

# Object storage (S3-compatible)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=ward-ops-evidence
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Owner setup
BOOTSTRAP_ADMIN_EMAIL=officer@makina.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
OWNER_SETUP_TOKEN=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=makina-ward@example.go.ke

# AI (optional)
AI_ENABLED=false
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instant

# Uploads
MAX_UPLOAD_BYTES=5242880
